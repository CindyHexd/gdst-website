---
import SubPage from '../../components/SubPage.astro'
import { getContent } from '../../i18n'

const t = getContent('zh')
const { business: b } = t
---

<SubPage t={t} label="BUSINESS" title={b.title} intro={b.intro}>
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl space-y-14 px-4 sm:px-6">
      {
        b.segments.map((segment) => (
          <article id={segment.id} class="scroll-mt-28">
            <h2 class="text-2xl font-bold text-white">{segment.title}</h2>
            <p class="mt-4 max-w-3xl leading-relaxed text-slate-400">{segment.description}</p>
            {segment.productLinks && segment.productLinks.length > 0 && (
              <ul class="mt-6 divide-y divide-white/8 rounded-2xl border border-white/8 bg-white/[0.02]">
                {segment.productLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="flex items-center justify-between gap-4 px-5 py-4 text-sm font-medium text-white hover:bg-white/5 hover:text-brand-300"
                    >
                      {link.label}
                      <span aria-hidden="true" class="text-brand-400">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </section>
</SubPage>
