---
import { getContent } from '../../i18n'
import CaseDetailPage from '../../views/cases/CaseDetailPage.astro'

export function getStaticPaths() {
  const t = getContent('zh')
  return t.cases.map((item) => ({
    params: { slug: item.href.split('/').filter(Boolean).at(-1) },
    props: { item },
  }))
}

const { item } = Astro.props
---

<CaseDetailPage locale="zh" item={item} />
