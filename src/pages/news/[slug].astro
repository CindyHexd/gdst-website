---
import SubPage from '../../components/SubPage.astro'
import { getContent } from '../../i18n'

const t = getContent('zh')

export function getStaticPaths() {
  const t = getContent('zh')
  return t.news.map((item) => ({
    params: { slug: item.href?.split('/').filter(Boolean).at(-1) },
    props: { item },
  }))
}

const { item } = Astro.props
---

<SubPage t={t} label={item.date} title={item.title} intro={item.excerpt}>
  <section class="py-16 sm:py-20">
    <article class="mx-auto max-w-3xl px-4 text-slate-300 sm:px-6">
      <p class="leading-relaxed">
        {item.excerpt}
      </p>
      <p class="mt-5 leading-relaxed text-slate-400">
        本页面为本地站点新闻详情页，用于承载原首页新闻中心条目。后续可继续补充活动图片、会议议程、客户交流纪要与媒体资料。
      </p>
      <a href="/news/" class="mt-8 inline-flex text-sm font-semibold text-brand-400 hover:text-brand-300">返回新闻中心</a>
    </article>
  </section>
</SubPage>
