---
import SubPage from '../../components/SubPage.astro'
import NewsBody from '../../components/NewsBody.astro'
import { getContent } from '../../i18n'

const t = getContent('zh')

export function getStaticPaths() {
  const t = getContent('zh')
  return t.news.map((item) => ({
    params: { slug: item.href?.split('/').filter(Boolean).at(-1) },
    props: { item },
  }))
}

const { item } = Astro.props
const paragraphs = item.body ?? [t.ui.newsDetailPlaceholder]
---

<SubPage t={t} label={item.date} tags={item.tags} title={item.title} intro={item.excerpt}>
  <section class="py-10 sm:py-12">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <article class="space-y-5 leading-relaxed text-slate-300">
        <NewsBody blocks={paragraphs} />
        <a href="/news/" class="inline-flex text-sm font-semibold text-brand-400 hover:text-brand-300">
          {t.ui.backToNews}
        </a>
      </article>
    </div>
  </section>
</SubPage>
