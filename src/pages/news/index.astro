---
import SubPage from '../../components/SubPage.astro'
import { getContent } from '../../i18n'

const t = getContent('zh')
---

<SubPage t={t} label="NEWS" title="新闻" intro="汇集中科深源产品定型、行业会议、客户交流与学术活动动态。">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <ul class="divide-y divide-white/8">
        {
          t.news.map((item) => (
            <li class="py-6 first:pt-0 last:pb-0">
              <div class="flex flex-wrap items-center gap-2 text-sm">
                <span class="tag">{item.tag}</span>
                <time class="text-slate-500">{item.date}</time>
              </div>
              <h2 class="mt-2 text-xl font-semibold text-white">
                <a href={item.href} class="hover:text-brand-300">{item.title}</a>
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-400">{item.excerpt}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</SubPage>
