---
import SubPage from '../../components/SubPage.astro'
import ComparisonTable from '../../components/ComparisonTable.astro'
import SpecTable from '../../components/SpecTable.astro'
import { getContent } from '../../i18n'
import { withBase } from '../../utils/withBase'

const t = getContent('zh')
const pc = t.productCenter
const seismicProducts = t.products
const sensorProducts = t.secondaryProducts.map((p) => ({
  name: p.name,
  subtitle: t.productCenter.categories.find((c) => c.id === 'sensors')?.title ?? '',
  description: '',
  highlights: [] as string[],
  href: p.href,
  image: p.image,
}))
---

<SubPage t={t} label="PRODUCTS" title={pc.title} intro={pc.intro}>
  <section class="py-10 sm:py-12">
    <div class="mx-auto max-w-6xl space-y-12 px-4 sm:px-6">
      <div>
        <h2 class="text-lg font-semibold text-white">{pc.platformTitle}</h2>
        <div class="mt-4">
          <SpecTable rows={pc.platformRows} />
        </div>
      </div>

      {
        pc.categories.map((category) => {
          const items =
            category.id === 'seismic'
              ? seismicProducts
              : category.id === 'sensors'
                ? sensorProducts
                : []
          return (
            <div id={category.id}>
              <h2 class="text-2xl font-bold text-white">{category.title}</h2>
              {
                category.abbreviations && category.abbreviations.length > 0 && (
                  <ul class="mt-2 space-y-0.5 text-sm text-slate-500">
                    {category.abbreviations.map((line) => <li>{line}</li>)}
                  </ul>
                )
              }
              {category.description && (
                <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-400">{category.description}</p>
              )}
              {
                category.id === 'seismic' && (
                  <div class="mt-5">
                    <h3 class="text-lg font-semibold text-white">{pc.lineupTitle}</h3>
                    <div class="mt-3">
                      <ComparisonTable headers={pc.lineupHeaders} rows={pc.lineupRows} />
                    </div>
                  </div>
                )
              }
              {
                items.length > 0 && (
              <ul class="mt-6 grid gap-4 sm:grid-cols-2">
                {
                  items.map((product) => (
                    <li class="card flex flex-col">
                      {product.image && (
                        <img
                          src={product.image}
                          alt=""
                          class="mb-4 h-40 w-full object-contain"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                      <h3 class="text-base font-semibold text-white">{product.name}</h3>
                      {'subtitle' in product && product.subtitle && (
                        <p class="mt-1 text-sm text-brand-400">{product.subtitle}</p>
                      )}
                      {'description' in product && product.description && (
                        <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">{product.description}</p>
                      )}
                      {product.href && (
                        <a
                          href={withBase(product.href)}
                          class="mt-4 inline-flex text-sm font-semibold text-brand-400 hover:text-brand-300"
                        >
                          {t.ui.learnMore} →
                        </a>
                      )}
                    </li>
                  ))
                }
              </ul>
                )
              }
            </div>
          )
        })
      }
    </div>
  </section>
</SubPage>
