---
import { getCatalogProducts } from '../../data/productCatalog'
import ProductDetailPage from '../../views/products/ProductDetailPage.astro'

export function getStaticPaths() {
  return getCatalogProducts('zh').map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }))
}

const { product } = Astro.props
---

<ProductDetailPage locale="zh" product={product} />
