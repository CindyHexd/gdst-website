---
import SubPage from '../../components/SubPage.astro'
import { getContent } from '../../i18n'

const t = getContent('zh')
const detailProducts = [
  ...t.products,
  ...t.secondaryProducts.map((p) => ({
    ...p,
    subtitle: '宽频检波器',
    description: '面向地震采集、工程勘察与长期监测场景的有源力反馈式宽频传感器。',
    highlights: ['有源力反馈', '宽频响应', '长期稳定'],
  })),
]

export function getStaticPaths() {
  const t = getContent('zh')
  const detailProducts = [
    ...t.products,
    ...t.secondaryProducts.map((p) => ({
      ...p,
      subtitle: '宽频检波器',
      description: '面向地震采集、工程勘察与长期监测场景的有源力反馈式宽频传感器。',
      highlights: ['有源力反馈', '宽频响应', '长期稳定'],
    })),
  ]

  return detailProducts.map((product) => ({
    params: { slug: product.href?.split('/').filter(Boolean).at(-1) },
    props: { product },
  }))
}

const { product } = Astro.props
---

<SubPage
  t={t}
  label="PRODUCT DETAIL"
  title={product.name}
  intro={product.subtitle}
  backHref="/business/"
  backLabel={t.ui.backToBusiness}
>
  <section class="py-10 sm:py-12">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_360px]">
      <article class="space-y-6">
        <p class="text-lg leading-relaxed text-slate-300">{product.description}</p>
        <div>
          <h2 class="text-xl font-semibold text-white">核心特点</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-3">
            {product.highlights.map((item) => <li class="rounded-xl border border-white/8 bg-white/[0.03] px-4 py-3 text-sm text-slate-300">{item}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="text-xl font-semibold text-white">应用方向</h2>
          <p class="mt-3 leading-relaxed text-slate-400">
            可用于能源与矿产高精度勘探、城市地下空间探测、工程灾害监测预警、工业预测性维护等场景，并可与中科深源地学数据处理能力组合形成完整解决方案。
          </p>
        </div>
      </article>
      <aside class="card">
        {product.image && <img src={product.image} alt="" class="h-64 w-full object-contain" />}
      </aside>
    </div>
  </section>
</SubPage>
