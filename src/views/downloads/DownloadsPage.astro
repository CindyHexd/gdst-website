---
import SubPage from '../../components/SubPage.astro'
import {
  assertDownloadsCatalogComplete,
  downloadFileUrl,
  downloadSaveAs,
  downloadsCatalog,
} from '../../data/downloadsCatalog'
import { getContent } from '../../i18n'
import type { Locale } from '../../i18n/types'
import { withBase } from '../../utils/withBase'

interface Props {
  locale: Locale
}

assertDownloadsCatalogComplete()

const { locale } = Astro.props
const t = getContent(locale)
const { helpCenter: h } = t
const isZh = locale === 'zh'
---

<SubPage t={t} title={h.downloadsTitle} intro={h.downloadsIntro} backHref="/support/" backLabel={t.ui.backToHelp}>
  <section class="py-10 sm:py-12">
    <div class="mx-auto max-w-6xl space-y-10 px-4 sm:px-6">
      <div id="manuals">
        <h2 class="text-xl font-bold text-white">{h.manualsTitle}</h2>
        <ul class="mt-6 space-y-3">
          {
            downloadsCatalog.map((item) => (
              <li class="card flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <h3 class="min-w-0 font-semibold text-white">{isZh ? item.titleZh : item.titleEn}</h3>
                {
                  item.cn || item.en ? (
                    <div class="download-actions grid shrink-0 grid-cols-2 gap-x-6 sm:gap-x-8">
                      <div class="min-w-[4.5rem] text-right">
                        {
                          item.cn ? (
                            <a
                              href={downloadFileUrl(item.cn, withBase)}
                              download={downloadSaveAs(item, 'cn')}
                              class="whitespace-nowrap text-sm font-semibold text-brand-400 hover:text-brand-300"
                            >
                              {t.ui.downloadZh}
                            </a>
                          ) : null
                        }
                      </div>
                      <div class="min-w-[4.5rem] text-right">
                        {
                          item.en ? (
                            <a
                              href={downloadFileUrl(item.en, withBase)}
                              download={downloadSaveAs(item, 'en')}
                              class="whitespace-nowrap text-sm font-semibold text-brand-400 hover:text-brand-300"
                            >
                              {t.ui.downloadEn}
                            </a>
                          ) : null
                        }
                      </div>
                    </div>
                  ) : (
                    <p class="shrink-0 text-sm text-slate-500">{t.ui.preparing}</p>
                  )
                }
              </li>
            ))
          }
        </ul>
      </div>

      <div id="guides">
        <h2 class="text-xl font-bold text-white">{h.guidesTitle}</h2>
        <ul class="mt-6 grid gap-4 md:grid-cols-2">
          {
            h.guides.map((item) => (
              <li class="card">
                <h3 class="font-semibold text-white">{item.title}</h3>
                <p class="mt-2 text-sm text-slate-400">{item.description}</p>
                {
                  item.detail ? (
                    <p class="mt-3 text-sm leading-relaxed text-slate-400">{item.detail}</p>
                  ) : (
                    <p class="mt-3 text-xs text-slate-500">{t.ui.preparing}</p>
                  )
                }
              </li>
            ))
          }
        </ul>
      </div>

      <div id="software">
        <h2 class="text-xl font-bold text-white">{h.softwareTitle}</h2>
        <ul class="mt-6 grid gap-4 md:grid-cols-2">
          {
            h.software.map((item) => (
              <li class="card">
                <h3 class="font-semibold text-white">{item.title}</h3>
                <p class="mt-2 text-sm text-slate-400">{item.description}</p>
                {
                  item.detail ? (
                    <p class="mt-3 text-sm leading-relaxed text-slate-400">{item.detail}</p>
                  ) : (
                    <p class="mt-3 text-xs text-slate-500">{t.ui.preparing}</p>
                  )
                }
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</SubPage>
