---
import SubPage from '../../components/SubPage.astro'
import ProductContentBody from '../../components/ProductContentBody.astro'
import type { CatalogProduct } from '../../data/productCatalog'
import { downloadFileUrl, downloadSaveAs, getDownloadItemBySlug } from '../../data/downloadsCatalog'
import { getProductContent } from '../../data/productContent'
import { getContent } from '../../i18n'
import type { Locale } from '../../i18n/types'
import { withBase } from '../../utils/withBase'

interface Props {
  locale: Locale
  product: CatalogProduct
}

const { locale, product } = Astro.props
const t = getContent(locale)
const content = getProductContent(product.slug, locale)
const downloads = getDownloadItemBySlug(product.slug)
---

<SubPage
  t={t}
  title={product.name}
  intro={content?.excerpt ?? ''}
  backHref="/products/"
  backLabel={t.ui.backToProducts}
>
  <section class="py-10 sm:py-12">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <article class="space-y-8">
          {
            content && content.sections.length > 0 ? (
              <ProductContentBody sections={content.sections} />
            ) : (
              <p class="text-sm text-slate-500">{t.ui.preparing}</p>
            )
          }

          {
            downloads && (downloads.cn || downloads.en) && (
              <div class="border-t border-slate-200 pt-8">
                <h2 class="text-lg font-semibold text-slate-800">{t.helpCenter.manualsTitle}</h2>
                <div class="download-actions mt-4 grid max-w-xs grid-cols-2 gap-x-6">
                  <div class="text-right">
                    {
                      downloads.cn && (
                        <a
                          href={downloadFileUrl(downloads.cn, withBase)}
                          download={downloadSaveAs(downloads, 'cn')}
                          class="text-sm font-semibold text-brand-400 hover:text-brand-300"
                        >
                          {t.ui.downloadZh}
                        </a>
                      )
                    }
                  </div>
                  <div class="text-right">
                    {
                      downloads.en && (
                        <a
                          href={downloadFileUrl(downloads.en, withBase)}
                          download={downloadSaveAs(downloads, 'en')}
                          class="text-sm font-semibold text-brand-400 hover:text-brand-300"
                        >
                          {t.ui.downloadEn}
                        </a>
                      )
                    }
                  </div>
                </div>
              </div>
            )
          }
      </article>
    </div>
  </section>
</SubPage>
