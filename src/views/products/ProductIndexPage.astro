---
import SubPage from '../../components/SubPage.astro'
import { getCatalogProducts } from '../../data/productCatalog'
import { getContent } from '../../i18n'
import type { Locale } from '../../i18n/types'
import { localeHref } from '../../utils/localeHref'
import { withBase } from '../../utils/withBase'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getContent(locale)
const pc = t.productCenter
const catalog = getCatalogProducts(locale)
const seismicProducts = catalog.filter((p) => p.category === 'seismic')
const sensorProducts = catalog.filter((p) => p.category === 'sensors')
---

<SubPage t={t} title={pc.title} intro={pc.intro}>
  <section class="py-10 sm:py-12">
    <div class="mx-auto max-w-6xl space-y-12 px-4 sm:px-6">
      {
        pc.categories.map((category) => {
          const items =
            category.id === 'seismic'
              ? seismicProducts
              : category.id === 'sensors'
                ? sensorProducts
                : []
          return (
            <div id={category.id}>
              <h2 class="text-2xl font-bold text-white">{category.title}</h2>
              {
                category.abbreviations && category.abbreviations.length > 0 && (
                  <ul class="mt-2 space-y-0.5 text-sm text-slate-500">
                    {category.abbreviations.map((line) => <li>{line}</li>)}
                  </ul>
                )
              }
              {category.description && (
                <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-400">{category.description}</p>
              )}
              {
                items.length > 0 && (
                  <ul class="mt-6 grid gap-4 sm:grid-cols-2">
                    {
                      items.map((product) => (
                        <li class="card flex flex-col">
                          {product.image && (
                            <img
                              src={withBase(product.image.startsWith('/') ? product.image : `/${product.image}`)}
                              alt=""
                              class="mb-4 h-40 w-full object-contain"
                              loading="lazy"
                              decoding="async"
                            />
                          )}
                          <h3 class="text-base font-semibold">
                            <a
                              href={localeHref(product.href, locale)}
                              class="text-white hover:text-brand-300"
                            >
                              {product.name}
                            </a>
                          </h3>
                        </li>
                      ))
                    }
                  </ul>
                )
              }
            </div>
          )
        })
      }
    </div>
  </section>
</SubPage>
