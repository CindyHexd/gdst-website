---
import type { Content } from '../i18n/types'
import { withBase } from '../utils/withBase'
import LanguageToggle from './LanguageToggle.astro'

interface Props {
  t: Content
}

const { t } = Astro.props
const { company, navLinks } = t
---

<header class="glass sticky top-0 z-50">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:gap-4 sm:px-6 sm:py-4">
    <a href={withBase(t.homePath)} class="flex shrink-0 items-center rounded-lg bg-white px-2.5 py-1.5">
      <img
        src={withBase('/logo.png')}
        alt={`${company.nameEn} ${company.shortName}`}
        width="3512"
        height="1868"
        class="h-11 w-auto object-contain sm:h-14"
        decoding="async"
      />
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label={t.ui.mainNav}>
      {
        navLinks.map((link) =>
          link.children ? (
            <div class="nav-dropdown group relative">
              <a
                href={withBase(link.href)}
                class="inline-flex items-center gap-1 rounded-lg px-2.5 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white"
              >
                {link.label}
                <svg class="h-4 w-4 opacity-70" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.94a.75.75 0 111.08 1.04l-4.24 4.5a.75.75 0 01-1.08 0l-4.24-4.5a.75.75 0 01.02-1.06z"
                    clip-rule="evenodd"></path>
                </svg>
              </a>
              <div class="nav-dropdown__panel invisible absolute left-0 top-full z-50 mt-1 min-w-[11rem] rounded-xl border bg-white p-2 opacity-0 shadow-lg transition-all group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <ul class="flex flex-col gap-0.5">
                  {
                    link.children.map((child) => (
                      <li>
                        <a
                          href={withBase(child.href)}
                          class="block rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-brand-600"
                        >
                          {child.label}
                        </a>
                        {child.children && (
                          <ul class="mt-1 space-y-0.5 pl-1">
                            {child.children.map((product) => (
                              <li>
                                <a
                                  href={withBase(product.href)}
                                  class="block rounded-lg px-2 py-1.5 text-xs leading-snug text-slate-600 hover:bg-slate-50 hover:text-brand-600"
                                >
                                  {product.label}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={withBase(link.href)}
              class="rounded-lg px-2.5 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white"
            >
              {link.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <LanguageToggle t={t} />
      <a
        href={withBase('/about/#contact')}
        class="hidden rounded-lg bg-brand-600 px-3 py-2 text-sm font-medium text-white hover:bg-brand-500 sm:inline-flex lg:px-4"
      >
        {t.ui.cta}
      </a>

      <div class="relative lg:hidden">
        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="nav-btn inline-flex cursor-pointer rounded-lg p-2 text-slate-300 hover:bg-white/5">
          <span class="icon-open" aria-hidden="true">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </span>
          <span class="icon-close" aria-hidden="true">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </span>
          <span class="sr-only">{t.ui.menu}</span>
        </label>
        <nav
          class="nav-panel absolute right-0 top-full z-50 mt-2 max-h-[70vh] w-72 overflow-y-auto rounded-xl border p-2 shadow-lg"
          aria-label={t.ui.mobileNav}
        >
          {
            navLinks.map((link) =>
              link.children ? (
                <div class="mb-2">
                  <a href={withBase(link.href)} class="block rounded-lg px-3 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-50">
                    {link.label}
                  </a>
                  <div class="mt-1 space-y-2 pl-2">
                    {
                      link.children.map((child) => (
                        <div>
                          <a href={withBase(child.href)} class="block rounded-lg px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">
                            {child.label}
                          </a>
                          {child.children && (
                            <div class="mt-0.5 space-y-0.5 pl-2">
                              {child.children.map((product) => (
                                <a href={withBase(product.href)} class="block rounded-lg px-3 py-1.5 text-xs text-slate-500 hover:bg-slate-50">
                                  {product.label}
                                </a>
                              ))}
                            </div>
                          )}
                        </div>
                      ))
                    }
                  </div>
                </div>
              ) : (
                <a href={withBase(link.href)} class="block rounded-lg px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-50">
                  {link.label}
                </a>
              ),
            )
          }
        </nav>
      </div>
    </div>
  </div>
</header>
