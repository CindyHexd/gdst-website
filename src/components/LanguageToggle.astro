---
import type { Content } from '../i18n/types'
import { alternateLocalePath } from '../utils/localePath'
import { withBase } from '../utils/withBase'

interface Props {
  t: Content
  pathname: string
}

const { t, pathname } = Astro.props
const zhHref = withBase(alternateLocalePath(pathname, 'zh'))
const enHref = withBase(alternateLocalePath(pathname, 'en'))
---

<div class="lang-switch" role="group" aria-label={t.ui.langSwitchLabel}>
  <a
    href={zhHref}
    class:list={['lang-switch__btn', { 'lang-switch__btn--active': t.locale === 'zh' }]}
    lang="zh-CN"
    hreflang="zh-CN"
    aria-current={t.locale === 'zh' ? 'page' : undefined}
  >
    中文
  </a>
  <a
    href={enHref}
    class:list={['lang-switch__btn', { 'lang-switch__btn--active': t.locale === 'en' }]}
    lang="en"
    hreflang="en"
    aria-current={t.locale === 'en' ? 'page' : undefined}
  >
    EN
  </a>
</div>
