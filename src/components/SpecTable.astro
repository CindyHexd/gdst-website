---
import type { SpecTableRow } from './specTableTypes'

interface Props {
  title?: string
  rows: SpecTableRow[]
}

const { title, rows } = Astro.props
---

{
  title && (
    <h3 class="mb-2 text-sm font-semibold text-slate-800">{title}</h3>
  )
}
<div class="spec-table-wrap overflow-x-auto rounded-lg border border-slate-200">
  <table class="spec-table w-full min-w-[280px]">
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            <td>
              {typeof row.value === 'string' ? (
                row.value
              ) : (
                <>
                  <p>{row.value.lead}</p>
                  {row.value.groups?.map((group) => (
                    <div class="mt-2">
                      <p class="font-medium text-slate-700">{group.heading}</p>
                      <ul class="mt-1 list-disc space-y-1 pl-4">
                        {group.bullets.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                  {row.value.bullets && row.value.bullets.length > 0 && (
                    <ul class="mt-1.5 list-disc space-y-1 pl-4">
                      {row.value.bullets.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )}
                </>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
