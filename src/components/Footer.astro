---
import type { Content } from '../i18n/types'

interface Props {
  t: Content
}

const { t } = Astro.props
const year = new Date().getFullYear()
---

<footer class="border-t border-white/8 py-8">
  <p class="mx-auto max-w-6xl px-4 text-center text-xs leading-relaxed text-slate-600 sm:px-6">
    {
      t.legal ? (
        <>
          {t.legal.publicSecurity} 版权所有© {t.company.name} {t.legal.icp}
        </>
      ) : (
        <>
          © {year} {t.company.name}. {t.ui.rights}
        </>
      )
    }
  </p>
</footer>
