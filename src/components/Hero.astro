---
import type { Content } from '../i18n/types'
import { withBase } from '../utils/withBase'

interface Props {
  t: Content
}

const { t } = Astro.props
const { company, hero } = t

function slideSrc(image: string): string {
  if (image.startsWith('http')) return image
  const path = image.startsWith('/') ? image : `/${image}`
  return withBase(path)
}

const slides = hero.slides.map((slide, index) => ({
  subtitle: slide.subtitle,
  src: slideSrc(slide.image),
  alt: index === 0 ? company.shortName : '',
}))
---

<section class="hero-banner border-b border-white/8" aria-label={company.nameEn}>
  <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 sm:py-6 lg:py-8">
    <div class="grid items-center gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(360px,1fr)] lg:gap-8">
      <div class="hero-banner__copy">
        <h1 class="hero-banner__title text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">{hero.title}</h1>
        <p class="hero-banner__subtitle mt-3 min-h-[3rem] max-w-2xl text-lg font-semibold leading-snug text-brand-400 sm:min-h-[3.25rem] sm:text-xl lg:min-h-[4rem] lg:text-2xl">
          {slides[0]?.subtitle}
        </p>
      </div>

      <div class="hero-gallery relative aspect-[16/10] overflow-hidden bg-white">
        {
          slides.map((slide, index) => (
            <img
              src={slide.src}
              alt={slide.alt}
              class="hero-gallery__slide absolute inset-0 h-full w-full object-contain"
              data-slide={index}
              data-subtitle={slide.subtitle}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  function initHeroBanner() {
    const banner = document.querySelector('.hero-banner')
    if (!banner) return

    const imageSlides = [...banner.querySelectorAll('.hero-gallery__slide')]
    const subtitleEl = banner.querySelector('.hero-banner__subtitle')
    const total = imageSlides.length
    if (total === 0) return

    let current = 0

    function show(index) {
      imageSlides.forEach((el, i) => {
        el.classList.toggle('is-active', i === index)
      })
      const subtitle = imageSlides[index]?.getAttribute('data-subtitle')
      if (subtitleEl && subtitle) {
        subtitleEl.textContent = subtitle
      }
    }

    show(0)

    if (total > 1) {
      setInterval(() => {
        current = (current + 1) % total
        show(current)
      }, 5000)
    }
  }

  initHeroBanner()
  document.addEventListener('astro:page-load', initHeroBanner)
</script>
