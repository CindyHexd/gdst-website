---
interface Props {
  title?: string
  headers: string[]
  rows: string[][]
}

const { title, headers, rows } = Astro.props
---

{
  title && (
    <h3 class="mb-2 text-sm font-semibold text-slate-800">{title}</h3>
  )
}
<div class="spec-table-wrap overflow-x-auto rounded-lg border border-slate-200">
  <table class="spec-table spec-table--comparison w-full min-w-[480px]">
    <thead>
      <tr>
        {
          headers.map((header, i) => (
            <th scope={i === 0 ? 'row' : 'col'} class="text-center">
              {header}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((cells) => (
          <tr>
            {
              cells.map((cell, i) =>
                i === 0 ? (
                  <th scope="row" class="text-center">{cell}</th>
                ) : (
                  <td class="text-center">{cell}</td>
                ),
              )
            }
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
