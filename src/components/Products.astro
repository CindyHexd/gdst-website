---
import type { Content } from '../i18n/types'

interface Props {
  t: Content
}

const { t } = Astro.props
---

<section id="products" class="py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="section-label">{t.sections.products.label}</p>
    <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{t.sections.products.heading}</h2>

    <ul class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        t.products.map((p) => (
          <li class="card flex flex-col overflow-hidden p-0">
            {p.image && (
              <img
                src={p.image}
                alt=""
                loading="lazy"
                class="h-52 w-full bg-slate-950 object-contain p-5"
              />
            )}
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl font-bold text-white">
                {p.href ? (
                  <a href={p.href} class="hover:text-brand-300">{p.name}</a>
                ) : (
                  p.name
                )}
              </h3>
              <p class="mt-1 text-sm text-brand-400">{p.subtitle}</p>
              <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-400">{p.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {p.highlights.map((h) => (
                  <li class="tag">{h}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>

    <ul class="mt-6 grid gap-6 md:grid-cols-2">
      {
        t.secondaryProducts.map((p) => (
          <li class="rounded-2xl border border-white/10 bg-slate-900/40 p-5">
            {p.image && (
              <img src={p.image} alt="" loading="lazy" class="h-36 w-full bg-slate-950 object-contain p-4" />
            )}
            <a href={p.href} class="mt-4 block font-semibold text-white hover:text-brand-300">
              {p.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
