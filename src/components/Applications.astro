---
import type { Content } from '../i18n/types'

interface Props {
  t: Content
}

const { t } = Astro.props
---

<section id="applications" class="border-t border-white/8 bg-slate-900/30 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="section-label">{t.sections.applications.label}</p>
    <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{t.sections.applications.heading}</h2>

    <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.applications.map((app) => (
          <li class="flex items-start gap-2 rounded-xl border border-white/8 bg-white/[0.02] px-4 py-3 text-sm text-slate-300">
            <span class="mt-1 text-brand-400" aria-hidden="true">▸</span>
            {app}
          </li>
        ))
      }
    </ul>

    <a href="/solutions/" class="mt-8 inline-flex text-sm font-semibold text-brand-400 hover:text-brand-300">
      {t.ui.viewMore}
    </a>
  </div>
</section>
