---
import type { Locale } from '../i18n/types'
import { getContent } from '../i18n'
import Layout from '../layouts/Layout.astro'
import Header from './Header.astro'
import Solution from './Solution.astro'
import CoreTechnology from './CoreTechnology.astro'
import Hero from './Hero.astro'
import Stats from './Stats.astro'
import News from './News.astro'
import Footer from './Footer.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getContent(locale)
---

<Layout t={t} pathname={Astro.url.pathname}>
  <Header t={t} />
  <main id="main">
    <Hero t={t} />
    <Stats t={t} />
    <Solution t={t} />
    <CoreTechnology t={t} />
    <News t={t} limit={t.homepageNewsLimit} heading={t.sections.recentNews.heading} />
  </main>
  <Footer t={t} />
</Layout>
