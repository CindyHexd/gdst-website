---
import type { Content } from '../i18n/types'
import Layout from '../layouts/Layout.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'

interface Props {
  t: Content
  label: string
  title: string
  intro?: string
  backHref?: string
  backLabel?: string
}

const { t, label, title, intro, backHref, backLabel } = Astro.props
---

<Layout t={t}>
  <Header t={t} />
  <main id="main" class="min-h-screen">
    <section class="border-b border-white/8 bg-slate-900/40 py-14 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        {backHref && backLabel && (
          <a href={backHref} class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-400 hover:text-brand-300">
            <span aria-hidden="true">←</span>
            {backLabel}
          </a>
        )}
        <p class:list={['section-label', backHref && 'mt-6']}>{label}</p>
        <h1 class="mt-3 max-w-4xl text-3xl font-bold leading-tight text-white sm:text-4xl">{title}</h1>
        {intro && <p class="mt-5 max-w-3xl text-base leading-relaxed text-slate-400">{intro}</p>}
      </div>
    </section>
    <slot />
  </main>
  <Footer t={t} />
</Layout>
