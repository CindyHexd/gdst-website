---
import type { Content } from '../i18n/types'
import { localeHref } from '../utils/localeHref'
import Layout from '../layouts/Layout.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'

interface Props {
  t: Content
  title: string
  date?: string
  tags?: string[]
  intro?: string
  backHref?: string
  backLabel?: string
}

const { t, title, date, tags, intro, backHref, backLabel } = Astro.props
const hasMeta = Boolean(date || (tags && tags.length > 0))
---

<Layout t={t} pathname={Astro.url.pathname}>
  <Header t={t} />
  <main id="main" class="min-h-screen">
    <section class="border-b border-white/8 bg-slate-900/40 py-10 sm:py-12">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        {backHref && backLabel && (
          <a href={localeHref(backHref, t.locale)} class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-400 hover:text-brand-300">
            <span aria-hidden="true">←</span>
            {backLabel}
          </a>
        )}
        <h1 class:list={['max-w-4xl text-3xl font-bold leading-tight text-white sm:text-4xl', backHref ? 'mt-6' : 'mt-0']}>
          {title}
        </h1>
        {
          hasMeta && (
            <div class="mt-3 flex flex-wrap items-center gap-2">
              {date && <time class="text-sm text-slate-500">{date}</time>}
              {tags?.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )
        }
        {intro && <p class="mt-5 max-w-3xl text-base leading-relaxed text-slate-400">{intro}</p>}
      </div>
    </section>
    <slot />
  </main>
  <Footer t={t} />
</Layout>
