---
import type { Content } from '../i18n/types'
import { localeHref } from '../utils/localeHref'

interface Props {
  t: Content
  limit?: number
  heading?: string
}

const { t, limit, heading } = Astro.props
const items = limit ? t.news.slice(0, limit) : t.news
const sectionHeading = heading ?? t.sections.news.heading
---

<section id="news" class="border-t border-white/8 py-10 sm:py-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-2xl font-bold text-white sm:text-3xl">{sectionHeading}</h2>

    <ul class="mt-8 divide-y divide-white/8">
      {
        items.map((item) => (
          <li class="py-4 first:pt-0 last:pb-0">
            <div class="flex flex-wrap items-center gap-2 text-sm">
              {item.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
              <time class="text-slate-500">{item.date}</time>
            </div>
            <h3 class="mt-2 text-lg font-semibold text-white">
              {item.href ? (
                <a href={localeHref(item.href!, t.locale)} class="hover:text-brand-300">{item.title}</a>
              ) : (
                item.title
              )}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{item.excerpt}</p>
          </li>
        ))
      }
    </ul>

    {limit && (
      <a href={localeHref('/news/', t.locale)} class="mt-8 inline-flex text-sm font-semibold text-brand-400 hover:text-brand-300">
        {t.ui.viewMore}
      </a>
    )}
  </div>
</section>
