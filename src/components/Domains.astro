---
import type { Content } from '../i18n/types'

interface Props {
  t: Content
}

const { t } = Astro.props

const icons: Record<string, string> = {
  energy: '⚡',
  urban: '🏙',
  industry: '⚙',
  data: '☁',
}
---

<section id="domains" class="border-t border-white/8 bg-slate-900/30 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="section-label">{t.sections.domains.label}</p>
    <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{t.sections.domains.heading}</h2>

    <ul class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        t.domains.map((d) => (
          <li class="card">
            <span class="text-2xl" aria-hidden="true">{icons[d.icon] ?? '◆'}</span>
            <p class="mt-3 text-xs font-medium text-brand-400">{d.subtitle}</p>
            <h3 class="mt-1 text-lg font-semibold text-white">{d.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-400">{d.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
