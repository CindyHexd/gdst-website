---
import type { Content } from '../i18n/types'

interface Props {
  t: Content
}

const { t } = Astro.props
const { company, contact, sections } = t
---

<section id="contact" class="border-t border-white/8 bg-slate-900/50 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="section-label">{sections.contact.label}</p>
    <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{sections.contact.heading}</h2>

    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <address class="card not-italic">
        <h3 class="text-sm font-medium text-slate-400">{contact.addressLabel}</h3>
        <p class="mt-2 text-white">{company.address}</p>
      </address>
      <div class="card">
        <h3 class="text-sm font-medium text-slate-400">{contact.emailLabel}</h3>
        <p class="mt-2">
          <a href={`mailto:${company.email}`} class="text-brand-400 hover:text-brand-300 break-all">
            {company.email}
          </a>
        </p>
      </div>
      <div class="card sm:col-span-2 lg:col-span-1">
        <h3 class="text-sm font-medium text-slate-400">{contact.phoneLabel}</h3>
        <p class="mt-2 text-white">{company.phone}</p>
        <p class="mt-4 text-xs text-slate-500">{contact.note}</p>
      </div>
    </div>
  </div>
</section>
