---
import type { Content } from '../i18n/types'

interface Props {
  t: Content
}

const { t } = Astro.props
---

<section id="stats" class="border-y border-white/8 bg-slate-900/50 py-12 sm:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <ul class="grid grid-cols-2 gap-8 lg:grid-cols-4">
      {
        t.stats.map((stat) => (
          <li class="text-center">
            <p class="font-mono text-2xl font-bold text-brand-400 sm:text-3xl lg:text-4xl">{stat.value}</p>
            <p class="mt-2 text-sm text-slate-400">{stat.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
